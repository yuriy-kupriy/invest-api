# ─────────────────────────────────────────────────────────────────────────────
# The environment contract. Every line here matches a field of the zod schema in
# src/config/env.schema.ts — `npm run check:env` verifies they stay in sync.
#
# This is the example file: it lives in git and holds NO real secrets. Copy it to
# .env (which is in .gitignore and .dockerignore) and edit values there.
# ─────────────────────────────────────────────────────────────────────────────

# Runtime mode: development | test | production. Defaults to development.
NODE_ENV=development

# HTTP port. A number; it arrives from the environment as a string, so the schema
# runs it through z.coerce.number().
PORT=3000

# REQUIRED. Postgres connection string WITHOUT a password — the password is a
# secret and lives in a file (see DB_PASSWORD_FILE), not in the environment.
# Port 5433: docker-compose publishes Postgres there, because host port 5432 is
# often taken by a locally installed server.
DB_URL=postgres://invest_app@localhost:5433/invest

# Path to the Postgres password file, relative to the process working directory.
# The file itself is gitignored; create it with `npm run secrets:init`.
DB_PASSWORD_FILE=./secrets/db_password

# Maximum size of the pg connection pool.
DB_POOL_MAX=10

# Timeout of a single connection attempt, in milliseconds.
DB_CONNECT_TIMEOUT_MS=5000

# Homework #9 leftover: DRIFT=1 makes the mapper emit amountCents instead of
# amount_cents, to watch the response validator catch a contract drift. 0 | 1.
DRIFT=0
