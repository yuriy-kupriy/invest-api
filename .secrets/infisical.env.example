# Copy to .secrets/infisical.env (gitignored) and fill in your own Infisical
# project. scripts/with-secrets.sh sources this file, exports the variables,
# then runs `infisical run --env=<slug> -- <command>`, which fetches
# DB_HOST/DB_PORT/DB_USER/DB_PASSWORD/DB_NAME from the vault and injects them
# into the wrapped command's environment.
INFISICAL_API_URL=https://app.infisical.com
INFISICAL_TOKEN=
INFISICAL_PROJECT_ID=
