{
  "name": "invest-api",
  "version": "1.0.0",
  "private": true,
  "description": "Course project: Money Manager with detailed investment tracking. Course homework #2 — zod-validated config (fail-fast), secrets outside git and the image, database password rotation without a restart.",
  "main": "dist/main.js",
  "scripts": {
    "start": "npm run build && node dist/main.js",
    "start:vault": "bash scripts/with-secrets.sh dev npm run start",
    "start:dev": "nest start --watch",
    "build": "nest build",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:e2e": "jest --config test/e2e/jest-e2e.json",
    "check:env": "npm run build && node scripts/check-env-example.mjs",
    "lint:spec": "redocly lint openapi/openapi.yaml",
    "bundle:spec": "redocly bundle openapi/openapi.yaml -o spec.json",
    "check:spec": "npm run lint:spec && npm run bundle:spec && node scripts/check-spec.js",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down -v",
    "db:fixtures": "docker compose exec -T postgres psql -U postgres -d invest -v ON_ERROR_STOP=1 -f - < db/dev-fixtures.sql",
    "secrets:init": "bash scripts/init-secret.sh",
    "rotate": "bash rotate.sh",
    "migrate": "bash scripts/with-secrets.sh dev npx typeorm migration:run -d dist/data-source.js",
    "migrate:show": "bash scripts/with-secrets.sh dev npx typeorm migration:show -d dist/data-source.js",
    "migrate:revert": "bash scripts/with-secrets.sh dev npx typeorm migration:revert -d dist/data-source.js",
    "seed": "bash scripts/with-secrets.sh dev node dist/seed.js",
    "demo:nplus1": "bash scripts/with-secrets.sh dev node dist/demo-nplus1.js",
    "demo:race": "bash scripts/with-secrets.sh dev node dist/demo-race.js",
    "demo:workers": "bash scripts/with-secrets.sh dev node dist/demo-workers.js",
    "demo:retry": "bash scripts/with-secrets.sh dev node dist/demo-retry.js",
    "demo:auth": "npm run build && bash scripts/with-secrets.sh dev node dist/demo-auth.js",
    "demo:reuse": "npm run build && bash scripts/with-secrets.sh dev node dist/demo-reuse.js",
    "demo:rbac": "npm run build && bash scripts/with-secrets.sh dev node dist/demo-rbac.js",
    "seed:realtime": "bash scripts/with-secrets.sh dev node dist/seed-realtime.js",
    "demo:realtime": "node scripts/realtime-demo.mjs",
    "demo:publish": "npm run build && bash scripts/with-secrets.sh dev node dist/demo-publish.js",
    "demo:dlq": "npm run build && bash scripts/with-secrets.sh dev node dist/demo-dlq.js",
    "demo:duplicate": "npm run build && bash scripts/with-secrets.sh dev node dist/demo-duplicate.js",
    "consumer:receipts": "bash scripts/with-secrets.sh dev node dist/order-receipts-consumer.js",
    "report": "bash scripts/with-secrets.sh dev node dist/report.js",
    "db:backup": "bash scripts/backup.sh",
    "db:restore-drill": "bash scripts/restore-drill.sh",
    "fx:dump": "bash scripts/fx-rates-snapshot.sh dump",
    "db:fx-rates": "bash scripts/fx-rates-snapshot.sh load",
    "test:integration": "jest --config test/integration/jest-integration.json",
    "test:contract": "jest --config test/contract/jest-consumer.json",
    "verify:provider": "jest --config test/contract/jest-provider.json"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/platform-socket.io": "^10.4.22",
    "@nestjs/swagger": "^7.4.2",
    "@nestjs/typeorm": "^11.0.3",
    "@nestjs/websockets": "^10.4.22",
    "amqplib": "^0.10.9",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "express": "^4.22.2",
    "express-openapi-validator": "^5.6.2",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.1",
    "tsconfig-paths": "^4.2.0",
    "typeorm": "^1.1.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/testing": "^10.4.15",
    "@pact-foundation/pact": "^13.2.0",
    "@redocly/cli": "^2.46.0",
    "@testcontainers/postgresql": "^10.28.0",
    "@types/amqplib": "^0.10.8",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.0.0",
    "testcontainers": "^10.28.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.2"
  }
}
